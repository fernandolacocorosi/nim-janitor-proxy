# Variáveis de ambiente (configure no painel do Vercel, NÃO suba um .env real pro GitHub)

# Opcional: se definida, a chave da NVIDIA fica escondida no servidor
# e você não precisa colocá-la no Janitor AI.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Recomendado junto com NVIDIA_API_KEY: uma senha qualquer sua.
# Você coloca ela no campo "API Key" do Janitor AI para ninguém mais usar seu proxy.
PROXY_ACCESS_KEY=uma-senha-forte-aqui

# Opcional: força sempre o mesmo modelo, ignorando o que o Janitor enviar.
# FORCE_MODEL=meta/llama-3.3-70b-instruct

# Opcional: troca a URL base da NVIDIA (padrão já é a correta)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
